{
	"name": "n8n-nodes-waapi",
	"version": "0.1.2",
	"description": "WAAPI community nodes for WhatsApp and connected messaging channels, contacts, conversations, templates, campaigns, automations, and signed event triggers.",
	"license": "MIT",
	"homepage": "https://waapi.chat/en/developers",
	"keywords": [
		"n8n-community-node-package",
		"waapi",
		"whatsapp",
		"messaging",
		"automation"
	],
	"author": {
		"name": "Alsaifi Ltd",
		"email": "info@digital-shift.us"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/alsaifiltd/n8n-nodes-waapi.git"
	},
	"scripts": {
		"build": "n8n-node build",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"typecheck": "tsc --noEmit",
		"test": "npm run build && node --test test/*.test.cjs",
		"prepublishOnly": "npm run lint && npm run test"
	},
	"files": [
		"dist",
		"examples",
		"CHANGELOG.md",
		"RELEASE.md"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/WaapiApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/Waapi/Waapi.node.js",
			"dist/nodes/Waapi/WaapiTrigger.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "0.52.5",
		"@types/node": "^22.0.0",
		"eslint": "9.39.4",
		"n8n-workflow": "2.16.0",
		"prettier": "3.6.2",
		"typescript": "5.9.3"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	},
	"bugs": {
		"url": "https://github.com/alsaifiltd/n8n-nodes-waapi/issues"
	},
	"engines": {
		"node": ">=22.16"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	}
}
